{
  "name": "dsh-token-ledger",
  "version": "0.1.0",
  "description": "Shows this machine's lifetime DSH token total in the conversation header, summed across every session and kept after sessions are deleted.",
  "type": "module",
  "license": "MIT",
  "author": "yinshipeng <yinshipeng@126.com>",
  "homepage": "https://github.com/yinshipeng/dsh-token-ledger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinshipeng/dsh-token-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/yinshipeng/dsh-token-ledger/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "tokens",
    "token-usage",
    "usage",
    "header",
    "ledger"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
